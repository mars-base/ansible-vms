---

# Global variables for all hosts
# Copy to vms_all.yaml and edit
#
# These are default values used when fields in vms.csv are empty.
# Adjust according to your environment.

# Default VM specifications (used when not specified in vms.csv)
vm_default_vcpus: 2
vm_default_memory_mb: 4096
vm_default_disk_gb: 50
vm_default_os: ubuntu22.04

# VM image storage paths
# vm_images_dir: default directory for VM files (each VM gets a subdirectory)
# vm_templates_dir: directory for base/template images
vm_images_dir: /var/lib/libvirt/images
vm_templates_dir: /srv/vm-templates

# Network configuration
# vm_default_network: libvirt network name (for NAT mode)
# vm_default_bridge: bridge name (for bridge mode, VMs get LAN IP)
vm_default_network: default
vm_default_bridge: virbr0

# SSH key configuration
# vm_ssh_key_type: key algorithm (ed25519 recommended for speed/security)
# vm_ssh_key_path: path to SSH private key for remote host connections
vm_ssh_key_type: ed25519
vm_ssh_key_path: ~/.ssh/id_ed25519
