# VM Definition (vms.csv)
# Copy to vms.csv and edit with your VM definitions
#
# Fields:
#   name        - VM name (unique identifier, used in virsh commands)
#   host        - KVM host (must match inventory name in hosts.ini)
#   type        - OS type: windows / linux
#   memory_mb   - Memory in MB
#   vcpus       - CPU cores
#   os          - OS variant (used for virt-install --os-variant)
#   disk_gb     - System disk size in GB
#   data_disk_gb - Data disk size in GB (0 or empty = no data disk)
#   base_image  - Base qcow2 image path (must exist on host)
#   bridge      - Network bridge name (e.g. br0)
#   mac         - MAC address (pinned for stable DHCP lease, use 52:54:00:xx:xx:xx)
#   firmware    - Boot firmware: efi / empty (BIOS for Linux, efi for Windows)
#   autostart   - Auto-start on host boot: true / false
#   storage_dir - Custom storage path (empty = default /var/lib/libvirt/images)
#                 VM files stored in <storage_dir>/<vm-name>/
#   ip          - Static IP address (empty = DHCP, Linux VM only)
#   netmask     - Subnet CIDR (default: 22, e.g. 24 for 255.255.255.0)
#   gateway     - Default gateway
#   dns         - DNS servers (comma-separated, e.g. "8.8.8.8,8.8.4.4")
#
# Usage:
#   ap playbooks/create-vm.yaml          # Create all VMs
#   ap playbooks/destroy-vm.yaml -e vm_name=xxx -e confirm=true  # Destroy VM

name,host,type,memory_mb,vcpus,os,disk_gb,data_disk_gb,base_image,bridge,mac,firmware,autostart,storage_dir,ip,netmask,gateway,dns
