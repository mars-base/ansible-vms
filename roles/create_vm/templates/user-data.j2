#cloud-config

hostname: {{ vm.name }}
fqdn: {{ vm.name }}
manage_etc_hosts: true
locale: {{ vm.cloud_init_locale | default(vm_cloud_init_locale) }}
timezone: {{ vm.cloud_init_timezone | default(vm_cloud_init_timezone) }}

users:
  - name: {{ vm.cloud_init_user | default(vm_cloud_init_user) }}
    shell: /bin/bash
    sudo: ALL=(ALL) NOPASSWD:ALL
{% set _password = vm.cloud_init_ssh_password | default(vm_cloud_init_ssh_password, true) | default('', true) %}
{% if _password != '' %}
    lock_passwd: false
    plain_text_passwd: "{{ _password }}"
{% endif %}
{% set _ssh_keys = vm.cloud_init_ssh_authorized_keys | default(vm_cloud_init_ssh_authorized_keys, true) | default([], true) %}
{% if _ssh_keys | length > 0 %}
    ssh_authorized_keys:
{% for key in _ssh_keys %}
      - "{{ key }}"
{% endfor %}
{% endif %}

ssh_pwauth: {{ 'true' if _password != '' else 'false' }}
disable_root: false

# cc_locale only runs update-locale, which fails validation unless the
# locale is generated first (cloud images ship only C.UTF-8).
bootcmd:
  - locale-gen {{ vm.cloud_init_locale | default(vm_cloud_init_locale) }}

write_files:
  # LANs where deb.debian.org resolves to AAAA but has no working IPv6 route
  # hang apt (and thus cloud-init's package install) on first boot.
  - path: /etc/apt/apt.conf.d/99force-ipv4
    content: |
      Acquire::ForceIPv4 "true";
{% if vm_apt_mirror is defined and vm_apt_mirror | length > 0 %}
  # Debian cloud images point sources at mirror+file:// lists; swapping the
  # list contents redirects apt without touching the sources files. The
  # security list mirrors the main one with a debian-security path.
  - path: /etc/apt/mirrors/debian.list
    content: "{{ vm_apt_mirror }}\n"
  - path: /etc/apt/mirrors/debian-security.list
    content: "{{ vm_apt_mirror | regex_replace('/debian/?$', '/debian-security') }}\n"
{% endif %}
{% if _password != '' %}
  - path: /etc/ssh/sshd_config.d/99-cloud-init-password.conf
    content: |
      PasswordAuthentication yes
      PermitRootLogin yes
{% endif %}
{% if vm.cloud_init_ssh_authorized_keys is defined and vm.cloud_init_ssh_authorized_keys | length > 0 %}
  - path: /root/.ssh/authorized_keys
    content: |
{% for key in vm.cloud_init_ssh_authorized_keys %}
      {{ key }}
{% endfor %}
    permissions: "0600"
{% endif %}

package_update: true
package_upgrade: false
packages:
{% for pkg in vm.cloud_init_packages | default(vm_cloud_init_packages) | union(vm.cloud_init_extra_packages | default(vm_cloud_init_extra_packages)) %}
  - {{ pkg }}
{% endfor %}

runcmd:
  - systemctl enable qemu-guest-agent
  - systemctl start qemu-guest-agent
  - systemctl restart ssh
