#cloud-config
{% set _locale = vm.cloud_init_locale | default(vm_cloud_init_locale) %}

hostname: {{ vm.name }}
fqdn: {{ vm.name }}
manage_etc_hosts: true
locale: {{ _locale }}
timezone: {{ vm.cloud_init_timezone | default(vm_cloud_init_timezone) }}

users:
  - name: {{ vm.cloud_init_user | default(vm_cloud_init_user) }}
    shell: /bin/bash
    sudo: ALL=(ALL) NOPASSWD:ALL
{% set _password = vm.cloud_init_ssh_password | default(vm_cloud_init_ssh_password, true) | default('', true) %}
{% if _password != '' %}
    lock_passwd: false
    plain_text_passwd: "{{ _password }}"
{% endif %}
{% set _ssh_keys = vm.cloud_init_ssh_authorized_keys | default(vm_cloud_init_ssh_authorized_keys, true) | default([], true) %}
{% if _ssh_keys | length > 0 %}
    ssh_authorized_keys:
{% for key in _ssh_keys %}
      - "{{ key }}"
{% endfor %}
{% endif %}

ssh_pwauth: {{ 'true' if _password != '' else 'false' }}
disable_root: false

# Debian cloud images ship a cloud.cfg that DROPS the write-files module
# (only write-files-deferred exists, in final stage), so every file drop
# here goes through bootcmd, which runs before the config stage.
bootcmd:
  # cc_locale's update-locale fails validation unless the locale exists;
  # Debian's locale-gen takes no argument, so enable it in /etc/locale.gen.
  - sed -i "s/^# {{ _locale }} {{ _locale.split('.')[-1] }}$/{{ _locale }} {{ _locale.split('.')[-1] }}/" /etc/locale.gen; locale-gen; update-locale LANG={{ _locale }}
  # LANs where deb.debian.org resolves to AAAA but has no working IPv6
  # route hang apt (and cloud-init's package install) on first boot.
  - echo 'Acquire::ForceIPv4 "true";' > /etc/apt/apt.conf.d/99force-ipv4
{% if _password != '' %}
  - printf 'PasswordAuthentication yes\nPermitRootLogin yes\n' > /etc/ssh/sshd_config.d/99-cloud-init-password.conf
{% endif %}
{% if vm_apt_mirror is defined and vm_apt_mirror | length > 0 and vm.os | default('') is match('^debian') %}

# Debian-only: the /debian -> /debian-security path mapping and the
# mirror+file:// list mechanism are specific to Debian cloud images.
# cc_apt_configure (config stage) regenerates those lists after bootcmd,
# so the mirror must go through cloud-init's own apt: config.
apt:
  preserve_sources_list: false
  primary:
    - arches: [default]
      uri: {{ vm_apt_mirror }}
  security:
    - arches: [default]
      uri: {{ vm_apt_mirror | regex_replace('/debian/?$', '/debian-security') }}
{% endif %}

package_update: true
package_upgrade: false
packages:
{% for pkg in vm.cloud_init_packages | default(vm_cloud_init_packages) | union(vm.cloud_init_extra_packages | default(vm_cloud_init_extra_packages)) %}
  - {{ pkg }}
{% endfor %}

runcmd:
  - systemctl enable qemu-guest-agent
  - systemctl start qemu-guest-agent
  - systemctl restart ssh
