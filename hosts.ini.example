# VM management inventory
# Copy to hosts.ini and edit for your environment

# kvm_hosts: KVM host for VM creation and management
[kvm_hosts]
local ansible_host=127.0.0.1 ansible_connection=local
# kvm-node-01 ansible_host=192.168.1.10 ansible_user=root

# vm_dev: development VMs
[vm_dev]

# vm_prod: production VMs
[vm_prod]

# vm_test: test VMs
[vm_test]

# all VMs
[vms:children]
vm_dev
vm_prod
vm_test
