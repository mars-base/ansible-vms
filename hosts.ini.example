# 虚拟机管理 inventory
# 请根据实际环境修改 IP、用户名和节点角色

# kvm_hosts: KVM 宿主机，用于创建和管理虚拟机
[kvm_hosts]
kvm-node-01 ansible_host=192.168.1.10 ansible_user=root

# vm_dev: 开发环境虚拟机
[vm_dev]
vm-dev-01 ansible_host=192.168.1.101 ansible_user=root

# vm_prod: 生产环境虚拟机
[vm_prod]
vm-prod-01 ansible_host=192.168.1.201 ansible_user=root

# vm_test: 测试环境虚拟机
[vm_test]

# 所有虚拟机
[vms:children]
vm_dev
vm_prod
vm_test
